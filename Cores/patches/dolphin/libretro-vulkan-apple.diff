--- a/Source/Core/VideoBackends/Vulkan/VulkanLoader.cpp	2026-10-23 16:51:16
+++ b/Source/Core/VideoBackends/Vulkan/VulkanLoader.cpp	2026-10-23 16:51:16
@@ -4,6 +4,8 @@
 #define VMA_IMPLEMENTATION
 #include "VideoBackends/Vulkan/VulkanLoader.h"
 
+#include <cstring>
+
 #if defined(ANDROID)
 #include <adrenotools/driver.h>
 #include <dlfcn.h>
@@ -94,6 +96,26 @@
 
 bool LoadVulkanLibrary(bool force_system_library)
 {
+#if defined(__APPLE__) && defined(__LIBRETRO__)
+  // Changed by Attic: iOS has no libvulkan to open. The frontend links MoltenVK and hands over its
+  // vkGetInstanceProcAddr (Libretro::Video::Vk::Init), which also gives the module functions.
+  // vkGetDeviceProcAddr needs an instance; Vk::Init sets it.
+  if (vkGetInstanceProcAddr)
+  {
+#define VULKAN_MODULE_ENTRY_POINT(name, required)                                                  \
+  if (!name)                                                                                       \
+    name = reinterpret_cast<PFN_##name>(vkGetInstanceProcAddr(VK_NULL_HANDLE, #name));            \
+  if (!name && required && std::strcmp(#name, "vkGetDeviceProcAddr") != 0)                         \
+  {                                                                                                \
+    ERROR_LOG_FMT(VIDEO, "Vulkan: Failed to load required module function {}", #name);             \
+    return false;                                                                                  \
+  }
+#include "VideoBackends/Vulkan/VulkanEntryPoints.inl"
+#undef VULKAN_MODULE_ENTRY_POINT
+    return true;
+  }
+#endif
+
   if (!s_vulkan_module.IsOpen() && !OpenVulkanLibrary(force_system_library))
     return false;
 
