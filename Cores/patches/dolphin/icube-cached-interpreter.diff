+// iCube: integer load/stores as micro-ops, so a load or store no longer ends a fused run. Same page
+// lookup and the same fall-back rules as LoadStoreFast.
+namespace
+{
+template <bool indexed>
+inline u32 CI_MicroMemEA(const PowerPC::PowerPCState& ppc_state, const MicroOpPayload& m)
+{
+  return ppc_state.gpr[m.ra] + (indexed ? ppc_state.gpr[m.rb] :
+                                          static_cast<u32>(s32{static_cast<s16>(m.imm)}));
+}
+
+// Returns false, with no side effect, when the access cannot take the direct path (MMIO, gather pipe,
+// unaligned, ...): the caller then leaves through a tail call to CI_SlowMem. The handler itself makes
+// no call, so it has no stack frame.
+template <CIMemKind kind, bool indexed, bool update>
+inline bool CI_MicroMemAccess(PowerPC::PowerPCState& ppc_state, const MicroOpPayload& m)
+{
+  const u32 ea = CI_MicroMemEA<indexed>(ppc_state, m);
+  u8* const page = CI_PagePtr(ppc_state, ea);
+  if (page == nullptr || (ea & CI_AlignMask(kind)) != 0) [[unlikely]]
+    return false;
+  if constexpr (CI_IsSubWordStore(kind))
+  {
+    if (CI_IsWriteInhibitedPage(ppc_state, ea)) [[unlikely]]
+      return false;
+  }
+  u8* const host = page + (ea & CI_PAGE_OFFSET_MASK);
+  switch (kind)
+  {
+  case CIMemKind::LWZ:
+    ppc_state.gpr[m.rd] = Common::swap32(CI_ReadHost<u32>(host));
+    break;
+  case CIMemKind::LBZ:
+    ppc_state.gpr[m.rd] = *host;
+    break;
+  case CIMemKind::LHZ:
+    ppc_state.gpr[m.rd] = Common::swap16(CI_ReadHost<u16>(host));
+    break;
+  case CIMemKind::LHA:
+    ppc_state.gpr[m.rd] =
+        static_cast<u32>(s32{static_cast<s16>(Common::swap16(CI_ReadHost<u16>(host)))});
+    break;
+  case CIMemKind::STW:
+    CI_WriteHost<u32>(host, Common::swap32(ppc_state.gpr[m.rd]));
+    break;
+  case CIMemKind::STB:
+    *host = static_cast<u8>(ppc_state.gpr[m.rd]);
+    break;
+  case CIMemKind::STH:
+    CI_WriteHost<u16>(host, Common::swap16(static_cast<u16>(ppc_state.gpr[m.rd])));
+    break;
+  default:
+    break;
+  }
+  if constexpr (update)
+    ppc_state.gpr[m.ra] = ea;
+  return true;
+}
+
+// The slow side of a memory micro-op. Gather-pipe stores (GX command streams, so not rare) are served
+// right here with the inlined fast write; everything else runs the generic interpreter handler, which
+// is always correct. Out of line on purpose: this is where the calls live.
+template <CIMemKind kind, bool indexed, bool update>
+[[gnu::noinline]] void CI_SlowMem(PowerPC::PowerPCState& ppc_state, const MicroOpPayload& m)
+{
+  if constexpr (!update &&
+                (kind == CIMemKind::STW || kind == CIMemKind::STH || kind == CIMemKind::STB))
+  {
+    const u32 ea = CI_MicroMemEA<indexed>(ppc_state, m);
+    int stored;
+    if constexpr (kind == CIMemKind::STW)
+      stored = CI_GatherPipeFastStore<u32>(ppc_state, ea, ppc_state.gpr[m.rd]);
+    else if constexpr (kind == CIMemKind::STH)
+      stored = CI_GatherPipeFastStore<u16>(ppc_state, ea, static_cast<u16>(ppc_state.gpr[m.rd]));
+    else
+      stored = CI_GatherPipeFastStore<u8>(ppc_state, ea, static_cast<u8>(ppc_state.gpr[m.rd]));
+    // FastCheckGatherPipe, not CheckGatherPipe: the only thing the latter adds is
+    // JitInterface::CompileExceptionCheck(FIFOWrite), which exists so a JIT can recompile the
+    // storing block with an external-exception check after the FIFO write. It is pure overhead here
+    // — the CachedInterpreter never reads js.fifoWriteAddresses, and inside a fused micro-op run
+    // ppc_state.pc is the RUN's first instruction, not the store, so the probe's opcode test
+    // rejects it and it re-runs its CPUThreadGuard + HostRead<u32> + GetOpInfo on EVERY 32-byte
+    // burst, forever. Jit64/JitArm64 call FastCheckGatherPipe for the same reason. The pipe's own
+    // semantics (UpdateGatherPipe at the 32-byte threshold) are identical either way.
+    if (stored == 2)
+      s_gpfifo->FastCheckGatherPipe();
+    if (stored != 0)
+      return;
+  }
+  const UGeckoInstruction inst{m.imm};
+  Interpreter::GetInterpreterOp(inst)(*s_interpreter, inst);
+}
