+
+  template <bool chain>
+  static s32 ANDI(PowerPC::PowerPCState& ppc_state, const void* payload)
+  {
+    const MicroOpPayload& m = *static_cast<const MicroOpPayload*>(payload);
+    const u32 rs_val = ppc_state.gpr[m.ra];
+    const u32 ui = m.imm & 0xFFFFu;
