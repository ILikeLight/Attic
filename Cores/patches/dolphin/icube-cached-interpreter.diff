+{
+  switch (k)
+  {
+  case 0:  return "bx";
+  case 1:  return "bcx-taken";
+  case 2:  return "bcx-fallthru";
+  case 3:  return "blr";
+  case 4:  return "bctr";
+  default: return "other/idle";
+  }
+}
