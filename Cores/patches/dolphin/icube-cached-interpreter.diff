+CachedInterpreter::AnyCallback CachedInterpreter::GetLoadStoreFastCallback(CIMemKind kind,
+                                                                           bool indexed, bool update,
+                                                                           bool chain, bool checked)
+{
+#define CI_LS_PICK(K, X, U)                                                                        \
+  return checked ? (chain ? AnyCallback{LoadStoreFast<CIMemKind::K, X, U, true, true>} :           \
+                            AnyCallback{LoadStoreFast<CIMemKind::K, X, U, false, true>}) :         \
+                   (chain ? AnyCallback{LoadStoreFast<CIMemKind::K, X, U, true, false>} :          \
+                            AnyCallback{LoadStoreFast<CIMemKind::K, X, U, false, false>})
+#define CI_LS_FORMS(K)                                                                             \
+  case CIMemKind::K:                                                                               \
+    if (indexed)                                                                                   \
+    {                                                                                              \
+      if (update)                                                                                  \
+        CI_LS_PICK(K, true, true);                                                                 \
+      CI_LS_PICK(K, true, false);                                                                  \
+    }                                                                                              \
+    if (update)                                                                                    \
+      CI_LS_PICK(K, false, true);                                                                  \
+    CI_LS_PICK(K, false, false)
+  switch (kind)
+  {
+    CI_LS_FORMS(LWZ);
+    CI_LS_FORMS(LBZ);
+    CI_LS_FORMS(LHZ);
+    CI_LS_FORMS(LHA);
+    CI_LS_FORMS(STW);
+    CI_LS_FORMS(STB);
+    CI_LS_FORMS(STH);
+    CI_LS_FORMS(LFS);
+    CI_LS_FORMS(LFD);
+    CI_LS_FORMS(STFS);
+    CI_LS_FORMS(STFD);
+    CI_LS_FORMS(PSQL);
+    CI_LS_FORMS(PSQST);
+  case CIMemKind::LWBR:
+    if (!indexed || update)
+      return nullptr;
+    CI_LS_PICK(LWBR, true, false);
+  case CIMemKind::LHBR:
+    if (!indexed || update)
+      return nullptr;
+    CI_LS_PICK(LHBR, true, false);
+  case CIMemKind::STWBR:
+    if (!indexed || update)
+      return nullptr;
+    CI_LS_PICK(STWBR, true, false);
+  case CIMemKind::STHBR:
+    if (!indexed || update)
+      return nullptr;
+    CI_LS_PICK(STHBR, true, false);
+  case CIMemKind::STFIW:
+    if (!indexed || update)
+      return nullptr;
+    CI_LS_PICK(STFIW, true, false);
+  case CIMemKind::DCBZ:
+    if (!indexed || update)
+      return nullptr;
+    CI_LS_PICK(DCBZ, true, false);
+  case CIMemKind::LMW:
+    if (indexed || update)
+      return nullptr;
+    CI_LS_PICK(LMW, false, false);
+  case CIMemKind::STMW:
+    if (indexed || update)
+      return nullptr;
+    CI_LS_PICK(STMW, false, false);
+  }
+#undef CI_LS_FORMS
+#undef CI_LS_PICK
+  return nullptr;
+}
