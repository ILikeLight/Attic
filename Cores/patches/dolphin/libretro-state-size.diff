@@ -551,7 +551,11 @@
   if (system.IsDualCoreMode())
     ar->SetPassthrough(false);
 
-  return size;
+  // Changed by Attic: room to grow. The CPU thread runs on between this measurement and
+  // retro_serialize, and meanwhile a Wii's Bluetooth queue can grow (about 1 KB an event). A state
+  // that did not fit was cut off without a word, losing what comes last: the Wii Remotes and, with
