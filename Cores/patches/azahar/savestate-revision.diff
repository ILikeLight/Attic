+// Changed by Attic: the revision as SaveStateBuffer writes it and LoadStateBuffer expects it.
+// Attic builds Azahar from a tree without .git, so g_scm_rev is "UNKNOWN": that hex-decodes to
+// nothing, so states got 20 zero bytes (copied from an empty string), and LoadStateBuffer, which
+// compared their hex with "UNKNOWN", refused every state. Unknown or short revisions give zeros
+// here too, so the states made before this change load as well.
+static std::array<u8, 20> StateRevision() {
+    std::string bytes;
+    CryptoPP::StringSource ss(Common::g_scm_rev, true,
+                              new CryptoPP::HexDecoder(new CryptoPP::StringSink(bytes)));
+    std::array<u8, 20> revision{};
+    std::memcpy(revision.data(), bytes.data(), std::min(bytes.size(), revision.size()));
+    return revision;
+}
